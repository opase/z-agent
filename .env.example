# 复制为 .env 并填入真实值。
# 加载优先级：shell 环境变量 > .env > settings.py 内默认值（空值行会被忽略）。

# ===== 大模型 API（必填）=====
DASHSCOPE_API_KEY=your-dashscope-api-key

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8080

# ===== 模型（可选，留空用默认）=====
# EMBEDDING_MODEL=text-embedding-v4
# CHAT_MODEL=glm-5.1
# RERANK_MODEL=gte-rerank-v2
# CLASSIFIER_MODEL=qwen-turbo
# VISION_MODEL=qwen3-vl

# ===== Token 预算与上下文压缩（可选）=====
# MODEL_CONTEXT_WINDOW=128000
# COMPRESSION_TRIGGER_RATIO=0.9
# REACT_RETAIN_RECENT_ROUNDS=3
# SHORT_TERM_MEMORY_RATIO=0.45

# ===== MCP / 审批（可选）=====
# MCP_CONFIG_PATH=
# APPROVAL_TIMEOUT_MINUTES=5
# APPROVAL_MAX_TOOLS_PER_SERVER=20
# MAX_MCP_SERVERS=10

# ===== SSE（可选）=====
# SSE_STRUCTURED_EVENTS=true

# ===== OpenTelemetry / Phoenix 追踪（可选）=====
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=z-agent
# OTEL_ENVIRONMENT=development
# PHOENIX_TRACES_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_METRICS_ENDPOINT=http://localhost:6006/v1/metrics
# PHOENIX_API_KEY=
# 2 个瞬时 Gauge（active_sessions/mcp_connection_status）是否发送。默认关闭：
# 旧版 Phoenix 不摄取 OTLP metrics（/v1/metrics 返回 405 → 每 10s 刷 ERROR）。
# 启用前提：Phoenix 版本支持 OTLP HTTP metrics，或改用 OTel Collector 作 metrics 后端。
# OTEL_METRICS_ENABLED=false
# OTEL_DEBUG_CONSOLE=false

# ===== 评估 / 消融实验（可选，写入 span 属性供 Phoenix 聚合对比）=====
# 语义成功率：每轮对话额外调一次 light_llm（qwen-turbo）当裁判，打 pass/score/reason。
# 默认关闭——开启后每轮多一次 LLM 调用（有延迟/成本），仅做成功率统计时打开。
# EVAL_SEMANTIC_ENABLED=false
# 消融实验标签：改实验参数时改这些值，Phoenix 按属性 group-by 即可对比不同方案效果。
# EXPERIMENT_ID=              # 本次实验标识，如 prompt-v2-run3
# PROMPT_VERSION=default      # 系统 prompt 版本
# RETRIEVAL_SCHEME=hybrid     # 检索方案：hybrid | vector | bm25
# TOOL_DESC_VERSION=default   # 工具描述版本

# ===== 文档解析器（可选）=====
# DOCUMENT_PARSER=auto              # auto | plain | mineru
# MINERU_METHOD=auto                # auto | cli | api-flash | api-precision
# MINERU_API_TOKEN=                 # 云端精准模式 token

# ===== 入库流水线（可选）=====
# INGESTION_CLEANING=true           # 启用噪声过滤
# INGESTION_DEDUP=true              # 启用语义去重
# INGESTION_DEDUP_THRESHOLD=0.92    # 语义去重相似度阈值
